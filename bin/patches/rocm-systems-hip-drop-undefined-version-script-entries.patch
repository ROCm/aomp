-    hiprtcVersion;
-    hiprtcLinkCreate;
-    hiprtcLinkAddFile;
-    hiprtcLinkAddData;
-    hiprtcLinkComplete;
-    hiprtcLinkDestroy;
     hipBindTexture;
     hipBindTexture2D;
     hipBindTextureToArray;
@@ -472,8 +456,6 @@ local:
 hip_5.3 {
 global:

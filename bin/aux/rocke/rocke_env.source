#
# Python environment, numeric reference, toolchain-built engine extension,
# and the conversion of a runner's report into result rows.
#
# Sourced by the driver; defines functions and tables only.
# shellcheck shell=bash
#
# Run state is owned by the driver and invisible to a check of this file alone.
# shellcheck disable=SC2154

# Resolve the run's interpreter: reuse the virtual environment, else create it.
function setupPython {
  local Need='import numpy, pytest' Existed=1
  PyBin=""

  if [[ -x "${ROCKE_VENV}/bin/python" ]]; then
    PyBin="${ROCKE_VENV}/bin/python"
    # An interrupted bootstrap leaves a venv that subsequent runs adopt, so
    # top it up.
    if [[ "${ROCKE_SETUP_VENV}" == "1" ]] \
      && ! "${PyBin}" -c "${Need}" 2>/dev/null; then
      "${PyBin}" -m pip install --quiet numpy pytest || true
    fi
  elif [[ "${ROCKE_SETUP_VENV}" == "1" ]]; then
    [[ -e "${ROCKE_VENV}" ]] || Existed=0
    if python3 -m venv "${ROCKE_VENV}" \
      && "${ROCKE_VENV}/bin/python" -m pip install --quiet --upgrade pip \
      && "${ROCKE_VENV}/bin/python" -m pip install --quiet numpy pytest; then
      PyBin="${ROCKE_VENV}/bin/python"
    elif (( Existed == 0 )); then
      rm -rf "${ROCKE_VENV}"  # only what this run created
    fi
  fi

  if [[ -z "${PyBin}" ]]; then
    echo "# WARN: venv unavailable, falling back to system python3"
    # Report the missing interpreter here; an empty one reports as a missing
    # module.
    PyBin="$(command -v python3)" \
      || failSetup "venv unavailable and no python3 in PATH" python
  fi

  # pytest matters as much as numpy: without it a lane produces no report at
  # all.
  local NotImportable="numpy and pytest must be importable with ${PyBin}"
  "${PyBin}" -c "${Need}" 2>/dev/null \
    || failSetup "${NotImportable} (venv ${ROCKE_VENV})" python
}

# Refuse to install into an interpreter this suite did not create: these are
# large packages and would stay behind in a user's own python long after the
# run.
function isPipInstallable {  # <what>
  [[ "${PyBin}" == "${ROCKE_VENV}/bin/"* ]] && return 0

  echo "WARNING: not installing ${1} into ${PyBin}: outside ${ROCKE_VENV}." \
       "Allow the venv (ROCKE_SETUP_VENV=1) or preinstall it yourself."
  return 1
}

# Read the dev extras rocKE declares in pyproject.toml, so a dependency it adds
# arrives without an edit here. torch stays separate: it must match the GPU
# stack.
function readRockeTestDeps {
  # Diagnostics go to stderr: the caller captures stdout as the dependency list.
  "${PyBin}" "${HelperDir}/rocke_probe.py" project-deps \
    "${ROCKE_TOP}/pyproject.toml"
}

# Install the test dependencies the project declares, so a missing one is a red
# row.
function ensureProjectTestDeps {
  local -a Deps=() Extra=()

  # Read separately: merged with the extras, an empty declared list stays
  # detectable.
  mapfile -t Deps < <(readRockeTestDeps)
  if (( ${#Deps[@]} == 0 )); then
    local CannotRead="cannot read rocKE's declared dev dependencies from"
    emitRockeResult setup python-test-deps 1 \
      "${CannotRead} ${ROCKE_TOP}/pyproject.toml"
    return 1
  fi

  read -ra Extra <<< "${ROCKE_EXTRA_TEST_DEPS}"
  Deps+=("${Extra[@]}")

  # No import check: import names differ from distribution names and pip is
  # fast.
  echo "provisioning rocKE-declared test dependencies: ${Deps[*]}"
  if isPipInstallable "rocKE dev test dependencies" \
    && "${PyBin}" -m pip install --quiet "${Deps[@]}"
  then
    return 0
  fi

  emitRockeResult setup python-test-deps 1 \
    "cannot provision rocKE dev test dependencies"
  return 1
}

# Datalayout generation a ROCm major.minor implies; empty when it is unusable.
function deriveDatalayoutGeneration {  # <major[.minor[.patch]]>
  local Major="${1%%.*}" Rest="${1#*.}" Minor=0

  # A bare major must not borrow itself as the minor: "7" is 7.0, not 7.7.
  [[ "${1}" == *.* ]] && Minor="${Rest%%.*}"
  [[ "${Major}" =~ ^[0-9]+$ && "${Minor}" =~ ^[0-9]+$ ]] || return 1

  # Generation, not flavor: every flavor from llvm22 on shares the indexed p8
  # shape.
  if (( Major > 7 || (Major == 7 && Minor >= 2) )); then
    echo indexed-p8
  else
    echo plain-p8
  fi
}

# Accept a torch usable as the numeric reference for this toolchain.
# Require the same datalayout generation, not the exact version: a toolchain
# carries an in-development ROCm no published torch matches, and rocKE uses its
# comgr anyway.
function validateTorch {
  local TorchVer TorchMajorMinor ToolchainGeneration TorchGeneration

  "${PyBin}" -c 'import torch' 2>/dev/null || return 1
  TorchVer="$("${PyBin}" -c 'import torch; print(torch.version.hip or "")' \
    2>/dev/null)"
  [[ -n "${TorchVer}" ]] || {
    echo "ERROR: ROCKE_VENV contains a non-ROCm torch build"
    return 1
  }

  TorchMajorMinor="$(cut -d. -f1,2 <<< "${TorchVer}")"
  ToolchainGeneration="$(deriveDatalayoutGeneration "${RocmVersion}" || true)"
  TorchGeneration="$(deriveDatalayoutGeneration "${TorchMajorMinor}" || true)"

  # A generation that cannot be established is not a match.
  if [[ -z "${ToolchainGeneration}" || -z "${TorchGeneration}" ]]; then
    echo "ERROR: cannot establish the datalayout generation of torch ROCm" \
         "${TorchVer:-?} against toolchain ROCm ${RocmVersion:-?}, so it" \
         "cannot be trusted as the numeric reference"
    return 1
  fi

  if [[ "${ToolchainGeneration}" != "${TorchGeneration}" ]]; then
    echo "ERROR: torch ROCm ${TorchVer} speaks the ${TorchGeneration}" \
         "datalayout, toolchain ROCm ${RocmVersion} the" \
         "${ToolchainGeneration} one"
    return 1
  fi

  if [[ -n "${RocmVersion}" && "${TorchMajorMinor}" != "${RocmVersion}" ]]; then
    echo "using torch ROCm ${TorchVer} as the numeric reference for" \
         "toolchain ROCm ${RocmVersion}" \
         "(same ${ToolchainGeneration} datalayout; rocKE still compiles" \
         "through the toolchain's comgr)"
  else
    echo "using torch ROCm ${TorchVer} from ${ROCKE_VENV}"
  fi

  return 0
}

# The wheel index a released ROCm publishes; an unreleased version has none.
function resolveRocmWheelIndex {  # <major.minor>
  [[ -n "${1}" ]] || return 1
  echo "https://download.pytorch.org/whl/rocm${1}"
}

# Install one package from a ROCm wheel index into the suite-owned venv.
function installRocmPackage {  # <package> <index>
  local Pkg="${1}" Idx="${2}"

  isPipInstallable "${Pkg} (may be several GB)" || return 1
  echo "provisioning ${Pkg} from ${Idx}"
  "${PyBin}" -m pip install --index-url "${Idx}" "${Pkg}" || {
    echo "ERROR: no ${Pkg} at ${Idx}"
    echo "       An unreleased toolchain ROCm has no published wheels. Point" \
         "ROCKE_TORCH_INDEX_URL at a released"
    echo "       index of the same generation" \
         "($(deriveDatalayoutGeneration "${RocmVersion}" || echo '?'))," \
         "e.g. $(resolveRocmWheelIndex 7.2), or install it in ${ROCKE_VENV}."
    return 1
  }
}

# Provide the numeric reference, provisioning only when a caller asked for it:
# an unreleased toolchain ROCm has no wheel index, so prepared hosts preinstall
# it.
function ensureTorch {
  validateTorch && return 0

  local Idx="${ROCKE_TORCH_INDEX_URL}"
  if [[ -z "${Idx}" ]]; then
    [[ "${ROCKE_PROVISION_TORCH}" == 1 ]] || return 1
    Idx="$(resolveRocmWheelIndex "${RocmVersion}")" || {
      echo "ERROR: no ROCm version for this install; set ROCKE_TORCH_INDEX_URL"
      return 1
    }
  fi

  installRocmPackage torch "${Idx}" || return 1
  validateTorch
}

# Require a cmake new enough for rocKE's block() (>= 3.25), which build lanes
# need.
function requireCmake {
  local Ver Major Minor

  Ver="$(cmake --version 2>/dev/null | head -1 \
    | grep -oE '[0-9]+\.[0-9]+' | head -1)"
  if [[ -z "${Ver}" ]]; then
    emitRockeResult setup cmake 1 \
      "cmake not found (need >= 3.25 for rocKE's block(); set ROCKE_CMAKE_BIN)"
    return 1
  fi

  Major="${Ver%%.*}"; Minor="${Ver#*.}"
  if (( Major < 3 || (Major == 3 && Minor < 25) )); then
    emitRockeResult setup cmake 1 \
      "cmake ${Ver} too old (need >= 3.25; set ROCKE_CMAKE_BIN)"
    return 1
  fi

  return 0
}

# Build rocKE's engine extension through rocKE's own pybind option, so there is
# no second recipe. Shared across lanes, so it lives outside the per-lane build
# dir and answers through a global: it also emits a result row on stdout.
function ensureEngineExtension {  # sets EngineExtDir
  local Root="${ROCKE_CI_BUILD_ROOT}/engine-ext" Ext Stamp Run
  EngineExtDir=""
  Stamp="${Root}/.rocke-run"
  Run="${ROCKE_RUN_ID}"

  if [[ ! -d "${ROCKE_TOP}/cpp" ]]; then
    local NoCpp="no ${ROCKE_TOP}/cpp:"
    emitRockeResult setup engine-extension 1 \
      "${NoCpp} cannot tell whether the engine extension is current" \
      "${LaneRelevance}"
    return 1
  fi

  # Lock before deciding: the decision reads the tree and one arm deletes it,
  # so a concurrent build could race into a half-linked module.
  mkdir -p "${Root}"
  acquireDirLock "${Root}.lock" "engine extension build"

  if [[ "${ROCKE_REBUILD}" == 1 \
    && "$(cat "${Stamp}" 2>/dev/null)" != "${Run}" ]]; then
    rm -rf "${Root}"
    mkdir -p "${Root}"
  else
    Ext="$(find "${Root}" -name 'rocke_engine*.so' -print -quit 2>/dev/null)"
    # Rebuild only when a C++ source is newer than the module already built.
    if [[ -n "${Ext}" ]] && [[ -z "$(find "${ROCKE_TOP}/cpp" -newer "${Ext}" \
         \( -name '*.cpp' -o -name '*.hpp' -o -name '*.h' \
            -o -name 'CMakeLists.txt' \) \
         -print -quit 2>/dev/null)" ]]; then
      EngineExtDir="$(dirname "${Ext}")"; return 0
    fi
  fi

  local PyBind
  PyBind="$("${PyBin}" -m pybind11 --cmakedir 2>/dev/null)"
  if [[ -z "${PyBind}" ]]; then
    local NoPybind="pybind11 unavailable in ${ROCKE_VENV};"
    emitRockeResult setup engine-extension 1 \
      "${NoPybind} rocKE's cross-engine tests cannot run" \
      "${LaneRelevance}"
    return 1
  fi

  echo "building the rocKE C++ engine extension (${Root})"
  if ! cmake -S "${ROCKE_TOP}" -B "${Root}" -DCMAKE_BUILD_TYPE=Release \
         -DROCKE_BUILD_PYBIND=ON -Dpybind11_DIR="${PyBind}" \
         -DPython3_EXECUTABLE="${PyBin}" > "${Root}/configure.log" 2>&1; then
    local ConfigureFailed="cmake configure failed for the engine extension"
    emitRockeResult setup engine-extension 1 \
      "${ConfigureFailed} (see ${Root}/configure.log)" \
      "${LaneRelevance}"
    return 1
  fi

  if ! cmake --build "${Root}" --target rocke_core rocke_engine \
         -j"$(nproc 2>/dev/null || echo 4)" > "${Root}/build.log" 2>&1; then
    # The toolchain compiles this, so a failure here is a toolchain finding.
    emitRockeResult setup engine-extension 1 \
      "toolchain build of the engine extension failed (see ${Root}/build.log)" \
      "${LaneRelevance}"
    return 1
  fi

  Ext="$(find "${Root}" -name 'rocke_engine*.so' -print -quit 2>/dev/null)"
  if [[ -z "${Ext}" ]]; then
    emitRockeResult setup engine-extension 1 \
      "engine extension not produced under ${Root}" "${LaneRelevance}"
    return 1
  fi

  # Stamp only now: a failed build must not claim this run already rebuilt.
  printf '%s\n' "${Run}" > "${Stamp}"
  EngineExtDir="$(dirname "${Ext}")"
}

# Require test files matching pytest's default python_files patterns: an
# argument pytest cannot collect from aborts the whole run.
function hasTests {  # <dir>
  [[ -d "${1}" && -r "${1}" ]] || return 1
  [[ -n "$(find "${1}" \( -name 'test_*.py' -o -name '*_test.py' \) \
             -print -quit 2>/dev/null)" ]]
}

# Extract a usage error from a runner log: pytest reports those on its output
# only.
function summarizeRunnerLog {  # <runner-log>
  local Log="${1:-}" Line

  [[ -n "${Log}" && -f "${Log}" ]] || return 0
  Line="$(grep -m1 -E '^(ERROR|ImportError while loading)' "${Log}")" \
    || return 0
  [[ -n "${Line}" ]] && printf ': %s' "${Line:0:160}"
}

# Run pytest from the tests dir under the relevance plugin; returns pytest's
# status.
function runPytest {  # <xml> <manifest> <log> [pytest args...]
  local Xml="${1}" Manifest="${2}" Log="${3}"; shift 3

  # A reused build dir still holds the previous report, which would be
  # republished as this run's verdict.
  rm -f "${Xml}" "${Manifest}" "${Log}"

  # --continue-on-collection-errors: one unimportable module must not abort
  # collection of every other test.
  ( cd "${ROCKE_TOP}/tests" \
    && ROCKE_RELEVANCE_OUT="${Manifest}" \
      PYTHONPATH="${PYTHONPATH}:${HelperDir}${EngineExtDir:+:${EngineExtDir}}" \
      "${PyBin}" -m pytest "$@" -p rocke_relevance -q \
        --continue-on-collection-errors --junitxml="${Xml}" ) 2>&1 \
    | tee "${Log}"
  return "${PIPESTATUS[0]}"
}

# Turn a JUnit report into result rows, or a red row when it is missing. An
# unexplained nonzero runner exit survives a partial, all-passing report.
# <xml> <group> [runner-status] [manifest] [runner-log] [-- <args>]
function emitJunit {
  local Xml="${1}" GroupDefault="${2}" RunStatus="${3:-0}" Manifest="${4:-}"
  local RunnerLog="${5:-}"
  local ParseStatus=0 Summary

  # Arguments after "--" reach the converter unchanged.
  shift $(( $# > 5 ? 5 : $# ))
  [[ "${1:-}" == "--" ]] && shift
  local -a LaneArgs=( "$@" )

  # The status a runner uses for "tests ran, some failed" (ctest uses 8). The
  # caller sets it; deriving it from the group label would tie it to a label
  # rename.
  local ExpectedFailureStatus="${ExpectedRunnerFailure:-1}"
  local -a RelevanceArgs=(--relevance-default "${LaneRelevance}")

  # Pass the path whenever the lane asked for one, present or not: the converter
  # reports an unreadable manifest, while gating here would fall back without a
  # row.
  [[ -n "${Manifest}" ]] && RelevanceArgs+=(--relevance "${Manifest}")

  # A lane whose tests all drive the toolchain sets a floor under empty
  # evidence.
  [[ -n "${LaneRelevanceFloor:-}" ]] \
    && RelevanceArgs+=(--relevance-floor "${LaneRelevanceFloor}")

  # Pin the flavor from the toolchain's own clang: a drift check run under
  # another flavor measures a different toolchain.
  [[ "${ROCKE_CODEGEN_FLAVOR:-auto}" != auto ]] \
    && RelevanceArgs+=(--toolchain-flavor "${ROCKE_CODEGEN_FLAVOR}"
                       --toolchain-datalayout "${ToolchainDatalayout:-}")

  if [[ -f "${Xml}" ]]; then
    "${PyBin}" "${HelperDir}/rocke_junit_results.py" \
      --junit "${Xml}" --group-default "${GroupDefault}" \
      "${RelevanceArgs[@]}" ${LaneArgs[@]+"${LaneArgs[@]}"} || ParseStatus=$?

    if (( ParseStatus != 0 )); then
      emitRockeResult setup "${GroupDefault}-junit" 1 \
        "cannot parse JUnit report (status ${ParseStatus})"
    fi

    if (( RunStatus != 0 )) \
      && { (( RunStatus != ExpectedFailureStatus )) \
        || ! grep -Eq '<(failure|error)[ />]' "${Xml}"; }; then
      Summary="$(summarizeRunnerLog "${RunnerLog}")"
      emitRockeResult setup "${GroupDefault}-runner" 1 \
        "test runner exited with status ${RunStatus}${Summary}"
    fi
  else
    emitRockeResult setup "${GroupDefault}-report" 1 \
      "no JUnit report produced$(summarizeRunnerLog "${RunnerLog}")"
  fi
}

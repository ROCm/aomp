   therock_set_implicit_llvm_options(LLVM "${CMAKE_CURRENT_SOURCE_DIR}/tools" "${_llvm_required_tools}")
 
   # Clang tools that are required.
@@ -123,6 +138,7 @@ block()
     CLANG_OFFLOAD_BUNDLER

diff --git a/compiler/CMakeLists.txt b/compiler/CMakeLists.txt
index cdd56f8..6b386ac 100644
--- a/compiler/CMakeLists.txt
+++ b/compiler/CMakeLists.txt
@@ -10,6 +10,11 @@ if(THEROCK_ENABLE_COMPILER)
   if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
     list(APPEND _extra_llvm_cmake_args "-DLLVM_ENABLE_PEDANTIC=OFF")
   endif()
+  list(APPEND _extra_llvm_cmake_args "-DLLVM_ENABLE_PROJECTS=clang;lld;clang-tools-extra;flang")
+  list(APPEND _extra_llvm_cmake_args "-DLLVM_ENABLE_RUNTIMES=libcxx;libcxxabi;libunwind;openmp;offload;compiler-rt;flang-rt;")
+  if (DEFINED ENV{AOMP_VERSION_STRING})
+    list(APPEND _extra_llvm_cmake_args "-DLLVM_VERSION_SUFFIX=_AOMP_$ENV{AOMP_VERSION_STRING}")
+  endif()
 
   # If the compiler is not pristine (i.e. has patches), then there will be a
   # ".amd-llvm.smrev" file present which must be used instead of the auto
@@ -67,6 +72,9 @@ if(THEROCK_ENABLE_COMPILER)
       -DCLANG_ENABLE_STATIC_ANALYZER=OFF
       -DCLANG_ENABLE_CLANGD=OFF
       -DCLANG_TIDY_ENABLE_STATIC_ANALYZER=OFF
+      -DCLANG_TOOL_CLANG_LINKER_WRAPPER_BUILD=ON
+      -DOPENMP_ENABLE_LIBOMPTARGET=ON
+      -DLIBOMPTARGET_BUILD_DEVICE_FORTRT=ON
 
       ${_extra_llvm_cmake_args}
     BUILD_DEPS
diff --git a/compiler/pre_hook_amd-llvm.cmake b/compiler/pre_hook_amd-llvm.cmake
index a01d500..111fce3 100644
--- a/compiler/pre_hook_amd-llvm.cmake
+++ b/compiler/pre_hook_amd-llvm.cmake
@@ -14,12 +14,28 @@ if(WIN32)
   #     Should they be supported? What depends on them?
   set(LLVM_ENABLE_LIBCXX OFF)
   set(LLVM_ENABLE_RUNTIMES "compiler-rt" CACHE STRING "Enabled runtimes" FORCE)
+  set(LLVM_ENABLE_PROJECTS "clang;lld;clang-tools-extra;flang" CACHE STRING "Enable LLVM projects" FORCE)
 else()
   set(LLVM_BUILD_LLVM_DYLIB ON)
   set(LLVM_LINK_LLVM_DYLIB ON)
   set(LLVM_ENABLE_LIBCXX ON)
-  set(LLVM_ENABLE_RUNTIMES "compiler-rt;libunwind;libcxx;libcxxabi;openmp" CACHE STRING "Enabled runtimes" FORCE)
-  # Settinng "LIBOMP_COPY_EXPORTS" to `OFF` "aids parallel builds to not interfere
+  set(LLVM_ENABLE_PROJECTS "clang;lld;clang-tools-extra;flang" CACHE STRING "Enable LLVM projects" FORCE)
+  set(LLVM_ENABLE_RUNTIMES "libcxx;libcxxabi;libunwind;openmp;offload;compiler-rt;flang-rt" CACHE STRING "Enabled runtimes" FORCE)
+
+  if("offload" IN_LIST LLVM_ENABLE_RUNTIMES)
+    set(OPENMP_ENABLE_LIBOMPTARGET ON)
+    set(LIBOMPTARGET_BUILD_DEVICE_FORTRT ON)
+    set(LIBOMPTARGET_ENABLE_DEBUG ON)
+    set(LIBOMPTARGET_NO_SANITIZER_AMDGPU ON)
+    set(LIBOMP_INSTALL_RPATH "\$ORIGIN:\$ORIGIN/../lib:\$ORIGIN/../../lib:\$ORIGIN/../../../lib")
+    # Disable building rocr-runtime as external project until libnuma-dev dependency can be satisifed
+    #set(LIBOMPTARGET_EXTERNAL_PROJECT_HSA_PATH "${THEROCK_SOURCE_DIR}/core/ROCR-Runtime")
+    #set(OFFLOAD_EXTERNAL_PROJECT_UNIFIED_ROCR ON)
+
+    # Disable ZSTD until dependency is resolved
+    set(LLVM_ENABLE_ZLIB OFF)
+  endif()
+  # Setting "LIBOMP_COPY_EXPORTS" to `OFF` "aids parallel builds to not interfere
   # with each other" as libomp and generated headers are copied into the original
   # source otherwise. Defaults to `ON`.
   set(LIBOMP_COPY_EXPORTS OFF)
@@ -27,7 +43,6 @@ endif()
 
